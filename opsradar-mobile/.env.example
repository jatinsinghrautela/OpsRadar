# Native Android emulator talks to the host through 10.0.2.2.
# Real phones require your host's LAN/VPN address or an HTTPS API URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Only needed when you deliberately configure free Expo Push + FCM/APNs.
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Allow plain HTTP only for an intentional personal LAN/debug build. Default: false.
# OPSRADAR_ALLOW_HTTP=true
# Set your own identifiers before commercial distribution.
# OPSRADAR_ANDROID_PACKAGE=com.yourbusiness.opsradar
# OPSRADAR_IOS_BUNDLE_ID=com.yourbusiness.opsradar
