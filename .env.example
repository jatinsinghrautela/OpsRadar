# Copy to `.env` at the repo root and fill in real values. Never commit `.env`.
# Docker Compose loads this file for the backend; frontend gets REACT_APP_* via compose.

# --- Postgres (Compose service hostname inside the network is "postgres") ---
POSTGRES_USER=opsradar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=opsradar
POSTGRES_PORT=5433

# --- Backend ---
# Inside Compose, DATABASE_URL is overridden to use host "postgres".
# For host-side `npm start` / `npm test`, use localhost + POSTGRES_PORT, e.g.:
#   postgres://opsradar:change_me_strong_password@localhost:5433/opsradar
DATABASE_URL=postgres://opsradar:change_me_strong_password@postgres:5432/opsradar
JWT_SECRET=change_me_long_random_jwt_secret
# Optional legacy alias (prefer JWT_SECRET):
# SECRET_KEY=
PORT=5000
CORS_ORIGIN=http://localhost:3000

# First-boot admin (created only if no admin exists). Must change password on first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.local

# Global resolved-alert retention (days). Per-app then per-server overrides in Admin UI.
ALERT_RETENTION_DAYS=30
# RETENTION_PRUNE_HOURS=6

# Agent liveness (seconds). CLI default interval 900; down after 2× interval.
# AGENT_HEARTBEAT_INTERVAL_SECONDS=900
# AGENT_HEARTBEAT_STALE_SECONDS=1800

# Optional Sequelize SQL logging:
# DB_LOGGING=true

# --- Email (legacy only; unused by active auth) ---
EMAIL_USER=
EMAIL_PASS=

# --- Frontend ---
REACT_APP_API_URL=http://localhost:5000

# --- CLI ---
# Each server has its own ingest API key (Admin → Servers → Agent key).
# Put that key in opsradar-cli/config.yaml — there is no shared ALERT_INGEST_API_KEY.
